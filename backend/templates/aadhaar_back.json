{
  "document": {
    "type": "aadhaar",
    "side": "back",
    "country": "IN",
    "card_variants": [
      "standard_paper",
      "pvc_smart_card",
      "eaadhaar_cutout"
    ],
    "languages": [
      "eng",
      "hin",
      "regional"
    ]
  },

  "privacy": {
    "store_full_aadhaar_number": false,
    "store_full_vid": false,
    "mask_sensitive_data": true
  },

  "ocr": {
    "engine": "paddleocr",
    "languages": [
      "eng",
      "hin"
    ],
    "confidence_threshold": 75,
    "detect_text_regions": true,
    "detect_rotation": true,
    "detect_skew": true,
    "allow_partial_text": true
  },

  "fields": {
    "address": {
      "required": true,
      "type": "multiline_text",
      "confidence_threshold": 70,
      "allow_single_language": true,
      "max_lines": 8
    },

    "care_of": {
      "required": false,
      "patterns": [
        "C/O",
        "S/O",
        "D/O",
        "W/O"
      ]
    },

    "district": {
      "required": false,
      "type": "text"
    },

    "state": {
      "required": true,
      "type": "text"
    },

    "pincode": {
      "required": true,
      "type": "numeric",
      "length": 6,
      "pattern": "^[0-9]{6}$"
    },

    "aadhaar_number": {
      "required": true,
      "type": "numeric",
      "length": 12,
      "pattern": "^[0-9]{4}\\s?[0-9]{4}\\s?[0-9]{4}$",
      "mask_output": true
    },

    "vid": {
      "required": false,
      "type": "numeric",
      "length": 16,
      "pattern": "^[0-9]{4}\\s?[0-9]{4}\\s?[0-9]{4}\\s?[0-9]{4}$",
      "mask_output": true
    },

    "details_timestamp": {
      "required": false,
      "orientation": "vertical_left",
      "pattern": "^Details as on\\s?:?\\s?[0-9]{2}/[0-9]{2}/[0-9]{4}$"
    },

    "website": {
      "required": false,
      "expected_domain": "uidai.gov.in"
    },

    "helpline": {
      "required": false,
      "expected_value": "1947"
    }
  },

  "layout": {
    "expected_orientation": "landscape",

    "variants": {
      "standard_paper": {
        "regions": {
          "government_header": {
            "required": true,
            "position": "top_center",
            "relative": {
              "x": 0.20,
              "y": 0.03,
              "width": 0.60,
              "height": 0.12
            }
          },

          "government_emblem": {
            "required": true,
            "position": "top_left"
          },

          "aadhaar_logo": {
            "required": true,
            "position": "top_right"
          },

          "timestamp_strip": {
            "required": false,
            "position": "left_vertical_margin"
          },

          "address_block": {
            "required": true,
            "position": "left_center"
          },

          "qr_code": {
            "required": true,
            "position": "right_center",
            "type": "secure_qr"
          },

          "aadhaar_number": {
            "required": true,
            "position": "bottom_center"
          },

          "vid": {
            "required": false,
            "position": "below_aadhaar_number"
          },

          "footer": {
            "required": true,
            "position": "bottom"
          }
        }
      },

      "pvc_smart_card": {
        "regions": {
          "government_header": {
            "required": true,
            "position": "top_center",
            "relative": {
              "x": 0.20,
              "y": 0.03,
              "width": 0.60,
              "height": 0.12
            }
          },

          "government_emblem": {
            "required": true,
            "position": "top_left"
          },

          "aadhaar_logo": {
            "required": true,
            "position": "top_right"
          },

          "timestamp_strip": {
            "required": false,
            "position": "left_vertical_margin"
          },

          "address_block": {
            "required": true,
            "position": "left_center"
          },

          "hologram": {
            "required": false,
            "position": "bottom_left"
          },

          "qr_code": {
            "required": true,
            "position": "right_center",
            "type": "secure_large_qr"
          },

          "aadhaar_number": {
            "required": true,
            "position": "bottom_center"
          },

          "vid": {
            "required": false,
            "position": "below_aadhaar_number"
          },

          "footer": {
            "required": true,
            "position": "bottom"
          }
        }
      },

      "eaadhaar_cutout": {
        "regions": {
          "government_header": {
            "required": true,
            "position": "top_center"
          },

          "government_emblem": {
            "required": true,
            "position": "top_left"
          },

          "aadhaar_logo": {
            "required": true,
            "position": "top_right"
          },

          "address_block": {
            "required": true,
            "position": "left_center"
          },

          "qr_code": {
            "required": true,
            "position": "right_center"
          },

          "aadhaar_number": {
            "required": true,
            "position": "bottom_center"
          },

          "footer": {
            "required": true,
            "position": "bottom"
          }
        }
      }
    },

    "alignment": {
      "enabled": true,
      "tolerance_pixels": 12
    }
  },

  "qr_analysis": {
    "enabled": true,

    "detection": {
      "required": true,
      "minimum_size_pixels": 200,
      "detect_multiple_qr": true
    },

    "decoding": {
      "enabled": true,
      "supports_uidai_secure_qr": true,
      "retry_with_grayscale": true,
      "retry_with_threshold": true,
      "retry_with_sharpening": true,
      "retry_with_upscaling": true
    },

    "validation": {
      "check_payload": true,
      "check_uidai_digital_signature": true
    },

    "cross_check": {
      "enabled": true,
      "compare_qr_with_ocr": true,
      "compare_aadhaar_number": true,
      "compare_address": true,
      "compare_pincode": true
    }
  },

  "image_forensics": {
    "security_features": {
      "detect_guilloche_pattern": true,
      "detect_hologram": true,
      "detect_ghost_image": false
    },

    "ela": {
      "enabled": true,
      "jpeg_quality": 90,
      "threshold": 25
    },

    "noise_analysis": {
      "enabled": true,
      "detect_inconsistent_noise": true
    },

    "compression_analysis": {
      "enabled": true,
      "detect_jpeg_artifacts": true,
      "detect_inconsistent_compression": true
    },

    "resampling_analysis": {
      "enabled": true,
      "detect_resized_regions": true,
      "detect_interpolation_artifacts": true
    },

    "edge_analysis": {
      "enabled": true,
      "detect_edge_inconsistency": true
    }
  },

  "copy_move_detection": {
    "enabled": true,
    "similarity_threshold": 0.85,
    "minimum_region_size": 500,
    "ignore_uniform_background": true
  },

  "text_analysis": {
    "enabled": true,

    "font": {
      "detect_size_difference": true,
      "detect_weight_difference": true,
      "detect_font_style_difference": true
    },

    "spacing": {
      "detect_character_spacing": true,
      "detect_word_spacing": true,
      "detect_line_spacing": true
    },

    "alignment": {
      "detect_horizontal_alignment": true,
      "detect_vertical_alignment": true,
      "detect_baseline_difference": true
    },

    "color": {
      "detect_text_color_difference": true
    }
  },

  "metadata_analysis": {
    "enabled": true,
    "extract_exif": true,
    "check_creation_date": true,
    "check_modification_date": true,
    "check_editing_software": true
  },

  "side_detection": {
    "enabled": true,
    "expected_side": "back",
    "detect_front_side": true,

    "back_side_indicators": [
      "address_block",
      "pincode",
      "qr_code",
      "aadhaar_number",
      "uidai.gov.in",
      "1947"
    ],

    "front_side_indicators": [
      "photo",
      "name",
      "date_of_birth",
      "gender"
    ],

    "minimum_confidence": 70
  },

  "cross_side_comparison": {
    "enabled": false,
    "reason": "Back-side verification is performed independently. No front-side upload or comparison is required."
  },

  "scoring": {
    "weights": {
      "ocr": 15,
      "qr": 30,
      "layout": 15,
      "security_features": 15,
      "image_forensics": 15,
      "metadata": 10
    },

    "thresholds": {
      "genuine": 80,
      "suspicious": 55,
      "likely_fake": 0
    },

    "score_rules": {
      "invalid_side": {
        "enabled": true,
        "maximum_score": 20
      },

      "missing_required_qr": {
        "enabled": true,
        "maximum_score": 60
      },

      "low_ocr_confidence": {
        "enabled": true,
        "penalty": 10
      },

      "forensic_anomaly": {
        "enabled": true,
        "penalty": 20
      }
    }
  },

  "output": {
    "show_authenticity_score": true,
    "show_ocr_confidence": true,
    "show_qr_status": true,
    "show_detected_variant": true,
    "show_detected_side": true,
    "show_suspicious_regions": true,
    "show_ela_heatmap": true,
    "show_forensic_analysis": true,
    "show_cross_side_comparison": false,
    "mask_aadhaar_number": true,
    "mask_vid": true
  }
}
