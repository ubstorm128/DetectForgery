      "aadhaar_number": {
        "required": true,
        "type": "numeric",
        "length": 12,
        "pattern": "^[0-9]{4}\\s?[0-9]{4}\\s?[0-9]{4}$",
        "mask_output": true
      },
      "vid": {
        "required": false,
        "type": "numeric",
